# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
cover.out

# Go workspace files. Note `authbridge/go.work` IS tracked despite this
# pattern — gitignore does not apply to already-tracked files, and that one is
# committed deliberately so every checkout gets the same module graph. This
# pattern stops *new* stray go.work files (and go.work.sum, which is generated).
go.work
go.work.sum

# Build artifacts and binaries
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.orig

# Local scratch / working notes (never committed)
.sketchpad/

# venv
venv
.venv

# Secrets and credentials
.env
.env.*
!.env.example
!.env.template
.env.local
*.key
*.pem
*.p12
*.jks
credentials.json
credentials.env
secrets.json
secrets.env
kubeconfig
*.kubeconfig

# Python
__pycache__/
*.pyc
.ruff_cache/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Go build artifacts — local `go build` outputs in cmd/* dirs
# (binary name matches the package dir; trivially `git add`-ed by mistake).
#
# Spelled out per binary on purpose. A Go binary has no extension, so no glob
# can tell "the compiled output" from a source file or a package directory —
# `authbridge/cmd/*/*` would ignore the source. One line per binary is the
# only pattern that is both complete and safe; keep adding to it.
authbridge/cmd/abctl/abctl
authbridge/cmd/authbridge-proxy/authbridge-proxy
authbridge/cmd/authbridge-envoy/authbridge-envoy
authbridge/cmd/authbridge-cpex/authbridge-cpex
authbridge/cmd/authbridge-praxis/authbridge-praxis
# `go build ./cmd/...` from authbridge/ drops binaries in that dir rather than
# in the package dir, so ignore those spellings too. `authbridge-lite` appears
# here but has no cmd/ entry above: it is a build variant of authbridge-proxy,
# not its own module, so only the authbridge/ spelling can ever exist.
authbridge/abctl
authbridge/authbridge-proxy
authbridge/authbridge-envoy
authbridge/authbridge-cpex
authbridge/authbridge-lite
authbridge/authbridge-praxis

# MLflow local tracking store — created by `mlflow` runs in the working tree.
# Local experiment state, not project source.
mlflow.db
mlruns/

# Cortex writes its CA + keys under ~/.cortex. This covers the fallback location
# used when $HOME is unresolvable, and any explicit `--ca-dir ./cortex-ca`, so a
# private key can never be committed from a demo run inside a checkout.
cortex-ca/

# Local git worktrees (git worktree add .worktrees/<name>). Committing these
# gitlinks pins another branch's checkout into this tree, which is never wanted.
.worktrees/

# `go build ./...` inside authbridge/scripts/profile-tags drops its 3 MB binary beside
# the source, where it is easy to stage by accident — it was, once.
/authbridge/scripts/profile-tags/profile-tags

# Output dir for `make abctl` / `make authbridge-proxy`.
/bin/
